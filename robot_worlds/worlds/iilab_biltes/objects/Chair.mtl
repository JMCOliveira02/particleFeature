#Ke 0.000000 0.000000 0.000000  # Emissive: no glow
#Ni 1.000000          # Refractive index: 1.0 = no refraction
#d 1.000000           # Transparency: fully opaque
#illum 2              # Illumination model: 2 = ambient + diffuse + specular

